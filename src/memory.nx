/**
  * NetX Standard Library - Memory Components
  * 
  * This library provides memory storage and manipulation components for use in NetX designs.
  * 
  * @file memory.nx
  */
library memory;

import utils.REG;
import selector.*;

/**
  * Shift Register
  *
  * This component implements a shift register with configurable width and reset value.
  * Data shifts from LSB to MSB on each clock cycle.
  *
  * @attr width      Width of the shift register in bits
  * @attr pos_edge   Triggers on rising edge of clock when true
  * @attr high_rst   Enables active-high reset when true
  * @attr rst_value  Value to load on reset
  *
  * @port clk        Clock signal
  * @port rst        Reset signal
  * @port din        Serial data input
  * @port dout       Parallel data output
  */
component SHIFT_REG(width, pos_edge, high_rst, rst_value) 
  : [clk, rst, din] -> [dout] {
  wire clk of clock();
  wire rst, din of bit(1);
  wire casted, dout of bit(width);
  casted <> CAST <> rst_value;

  let reg(i) = dout[i] <> REG(pos_edge, high_rst, casted[i]) <> [
    clk, rst, if i == 0 then din else reg(i - 1)
  ];
  reg(width - 1);
}

/**
  * Register File
  *
  * This component implements a register file with dual read ports and single write port.
  * Provides simultaneous read access to two different addresses.
  *
  * @attr width      Width of each register in bits
  * @attr capacity   Number of address bits (2^capacity registers total)
  * @attr pos_edge   Triggers on rising edge of clock when true
  * @attr high_rst   Enables active-high reset when true
  *
  * @port clk        Clock signal
  * @port rst        Reset signal
  * @port rd_addr_a  Read address for port A
  * @port rd_addr_b  Read address for port B
  * @port wr_en      Write enable signal
  * @port wr_addr    Write address
  * @port din        Data input for write operations
  * @port dout_a     Data output from port A
  * @port dout_b     Data output from port B
  */
component REG_FILE(width, capacity, pos_edge, high_rst) 
  : [clk, rst, rd_addr_a, rd_addr_b, wr_en, wr_addr, din] -> [dout_a, dout_b] {
  wire clk of clock();
  wire rst, wr_en of bit(1);
  wire rd_addr_a, rd_addr_b, wr_addr of bit(capacity);
  wire din, dout_a, dout_b of bit(width);

  let W = 2**capacity;
  wire data[W] of bit(width);

  wire wr_mask of bit(W);
  wr_mask <> DECODER(capacity) <> wr_addr;
  for (i in [0..W]) {
    data[i] <> REG(pos_edge, high_rst, 0) <> [clk, rst,
      MUX(1) <> [
        AND <> [wr_mask[i], wr_en], data[i], din
      ]
    ];
  }
  dout_a <> MUX(capacity) <> [rd_addr_a] ++ [data[i] | i in [0..W]];
  dout_b <> MUX(capacity) <> [rd_addr_b] ++ [data[i] | i in [0..W]];
}

/**
  * Synchronous FIFO
  *
  * This component implements a synchronous First-In-First-Out buffer with
  * configurable width and depth. Provides status signals for empty and full conditions.
  *
  * @attr width      Width of data words in bits
  * @attr capacity   Number of address bits (2^capacity words total)
  * @attr pos_edge   Triggers on rising edge of clock when true
  * @attr high_rst   Enables active-high reset when true
  *
  * @port clk        Clock signal
  * @port rst        Reset signal
  * @port wr_en      Write enable signal
  * @port rd_en      Read enable signal
  * @port din        Data input for write operations
  * @port dout       Data output for read operations
  * @port empty      Empty status flag (1 when FIFO is empty)
  * @port full       Full status flag (1 when FIFO is full)
  */
component SYNC_FIFO(width, capacity, pos_edge, high_rst) 
  : [clk, rst, wr_en, rd_en, din] -> [dout, empty, full] {
  wire clk of clock();
  wire din, dout of bit(width);
  wire rst, wr_en, rd_en, empty, full of bit(1);

  let W = 2**capacity;
  wire fifo[W] of bit(width);
  wire wptr, rptr of bit(capacity);

  let real_wr_en = AND <> [wr_en, NOT <> full];
  let real_rd_en = AND <> [rd_en, NOT <> empty];

  let reg = REG(pos_edge, high_rst, 0) <> [clk#, rst#, TO];
  let add_one(x) = ADD <> [x, CAST <> 1];
  let next_reg(x, cond, next) = x <> reg <> MUX(1) <> [cond, x, next];

  next_reg(wptr, real_wr_en, add_one(wptr));
  next_reg(rptr, real_rd_en, add_one(rptr));

  wire w_mask of bit(W);
  w_mask <> DECODER(capacity) <> wptr;
  for (i in [0..W]) {
    next_reg(fifo[i], AND <> [w_mask[i], real_wr_en], din);
  }
  
  next_reg(dout, real_rd_en, MUX(capacity) <> [rptr] ++ [fifo[i] | i in [0..W]]);

  full  <> EQ <> [add_one(wptr), rptr];
  empty <> EQ <> [wptr, rptr];
}