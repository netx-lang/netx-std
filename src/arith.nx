/**
  * NetX Standard Library - Arithmetic Components
  * 
  * This library provides arithmetic computation components for use in NetX designs.
  * 
  * @file arith.nx
  */
library arith;

import utils.REG;
import selector.*;
import memory.SHIFT_REG;

/**
  * 32-bit Square Root Calculator
  *
  * This component calculates the square root of a 32-bit input using
  * a non-restoring square root algorithm with shift registers.
  *
  * @attr pos_edge    Triggers on rising edge of clock when true
  * @attr high_rst    Enables active-high reset when true
  *
  * @port clk         Clock signal
  * @port rst         Reset signal
  * @port D           32-bit input value to compute square root of
  * @port Q           16-bit output square root result
  */
component SQRT32(pos_edge, high_rst) : [clk, rst, D] -> [Q] {
  wire clk of clock();
  wire rst of bit(1);
  wire D of bit(32);
  wire Q of bit(16);

  wire R, R_next, lhs, rhs of bit(18);
  let shift(init_value) = SHIFT_REG(16, pos_edge, high_rst, init_value) <> [clk#, rst#, TO];
  
  auto D_odd <> shift(CONCAT <> [D[i * 2 + 1] | i in [16..0]]) <> 1'b0;
  auto D_eve <> shift(CONCAT <> [D[i * 2]     | i in [16..0]]) <> 1'b0;
  Q <> shift(16'd0) <> NOT <> R_next[17];

  lhs <> CONCAT <> [R[15:0], D_odd[15], D_eve[15]];
  rhs <> CONCAT <> [Q, R[17], 1'b1];
  R_next <> MUX(1) <> [
    R[17],
    SUB <> [lhs, rhs],
    ADD <> [lhs, rhs]
  ];
  R <> REG(pos_edge, high_rst, 18'd0) <> [
    clk, rst, R_next
  ];
}

/**
  * Barrel Shifter
  *
  * This component performs barrel shifting on a data input.
  *
  * @attr stage     Number of stages (log2(width))
  *
  * @port din       Input data
  * @port shamt     Shift amount
  * @port dir       Shift direction (0 = left, 1 = right)
  * @port arith     Arithmetic shift flag
  * @port dout      Output data
  */
component BARREL_SHIFTER(stage) : [din, shamt, dir, arith] -> [dout] {
  let width = 2 ** stage;

  wire din, dout  of bit(width);
  wire shamt      of bit(stage);
  wire dir, arith of bit(1);

  auto sign_bit <> MUX(1) <> [arith, 1'b0, din[width - 1]];

  wire result[stage]  of bit(width);
  for i in [0..stage] {
      for j in [0..width] {
          let offset = 2 ** i;

          let last = (if i == 0 then din else result[i - 1]);
          let next_left  = if j >= offset        then last[j - offset] else 1'b0;
          let next_right = if j + offset < width then last[j + offset] else sign_bit;
          result[i][j] <> MUX(2) <> [
              CONCAT <> [dir, shamt[i]],
              last[j], next_left,
              last[j], next_right
          ];
      }
  }
  dout <> result[stage - 1];
}

/**
  * Half Adder
  *
  * This component computes the sum and carry-out of two single-bit inputs.
  *
  * @port a         First input bit
  * @port b         Second input bit
  * @port sum       Sum output bit
  * @port cout      Carry-out output bit
  */
component HALF_ADDER : [a, b] -> [sum, cout] {
  wire a, b      of bit(1);
  wire sum, cout of bit(1);
  sum  <> XOR <> [a, b];
  cout <> AND <> [a, b];
}

/**
  * Full Adder
  *
  * This component computes the sum and carry-out of two single-bit inputs and a carry-in.
  *
  * @port a         First input bit
  * @port b         Second input bit
  * @port cin       Carry-in input bit
  * @port sum       Sum output bit
  * @port cout      Carry-out output bit
  */
component FULL_ADDER : [a, b, cin] -> [sum, cout] {
  wire a, b, cin of bit(1);
  wire sum, cout of bit(1);
  let HA = HALF_ADDER;
  [sum, cout] <> [TO, OR] <> [HA, TO] <> [TO, HA] <> [a, b, cin];
}

/**
  * Ripple Carry Adder
  *
  * This component implements a ripple carry adder for multi-bit addition.
  *
  * @attr width     Bit-width of the adder
  *
  * @port a         First input operand
  * @port b         Second input operand
  * @port cin       Carry-in input bit
  * @port sum       Sum output
  * @port cout      Carry-out output bit
  */
component RIPPLE_CARRY_ADDER(width) : [a, b, cin] -> [sum, cout] {
  wire a, b, sum of bit(width);
  wire cin, cout of bit(1);

  let pattern(i) = [#sum[i], TO] <> FULL_ADDER <> [a[i]#, b[i]#, TO];
  let adder(i) = if i < 0 then TO else pattern(i) <> adder(i - 1);
  cout <> adder(width - 1) <> cin;
}

/**
  * Carry Lookahead Adder
  *
  * This component implements a carry lookahead adder for fast multi-bit addition.
  *
  * @attr width     Bit-width of the adder (max 32)
  *
  * @port a         First input operand
  * @port b         Second input operand
  * @port cin       Carry-in input bit
  * @port sum       Sum output
  * @port cout      Carry-out output bit
  */
component CARRY_LOOKAHEAD_ADDER(width) : [a, b, cin] -> [sum, cout] {
    wire a, b, sum of bit(width);
    wire cin, cout of bit(1);

    let P(i) =  OR <> [a[i], b[i]];
    let G(i) = AND <> [a[i], b[i]];
    let C(i) = 
        if i == 0 then cin
        else OR <> [G(i-1), AND <> [P(i-1), C(i-1)]];

    for i in [0..32] {
        sum[i] <> XOR <> [a[i], b[i], C(i)];
    }
    cout <> C(32);
}