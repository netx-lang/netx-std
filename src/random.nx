/**
  * NetX Standard Library - Random Number Generation
  * 
  * This library provides pseudo-random number generation components for use in NetX designs.
  * 
  * @file random.nx
  */
library random;

import utils.REG;

/**
  * Fibonacci Linear Feedback Shift Register
  *
  * This component implements a Fibonacci LFSR for pseudo-random number generation.
  * The feedback is computed by XORing specified tap positions and fed to the LSB.
  *
  * @attr width      Width of the LFSR in bits
  * @attr pos_edge   Triggers on rising edge of clock when true
  * @attr high_rst   Enables active-high reset when true
  * @attr seed       Initial seed value for the LFSR
  * @attr taps       Array of tap positions for feedback computation
  *
  * @port clk        Clock signal
  * @port rst        Reset signal
  * @port output     Pseudo-random output sequence
  */
component FIB_LFSR(width, pos_edge, high_rst, seed, taps) : [clk, rst] -> [output] {
  wire output of bit(width);
  wire clk of clock();
  wire rst of bit(1);

  let reg(i) = REG(pos_edge, high_rst, seed[i]) <> [clk#, rst#, TO];
  let lfsr(i) = output[i] <> reg(i) <> (
    if i == 0 then XOR <> [ output[i - 1] | i in taps ] 
    else lfsr(i - 1)
  );
  lfsr(width - 1);
}

/**
  * Galois Linear Feedback Shift Register
  *
  * This component implements a Galois LFSR for pseudo-random number generation.
  * The feedback from the MSB is XORed with intermediate tap positions.
  *
  * @attr width      Width of the LFSR in bits
  * @attr pos_edge   Triggers on rising edge of clock when true
  * @attr high_rst   Enables active-high reset when true
  * @attr seed       Initial seed value for the LFSR
  * @attr taps       Array of tap positions for feedback computation
  *
  * @port clk        Clock signal
  * @port rst        Reset signal
  * @port output     Pseudo-random output sequence
  */
component GALOIS_LFSR(width, pos_edge, high_rst, seed, taps) : [clk, rst] -> [output] {
  wire output of bit(width);
  wire clk of clock();
  wire rst of bit(1);

  let feedback = output[width - 1];
  let reg(i) = REG(pos_edge, high_rst, seed[i]) <> [clk#, rst#, TO];

  let lfsr(i) = output[i] <> reg(i) <> (
    if i == 0         then feedback 
    else if $contains(taps, i) then XOR <> [feedback, lfsr(i - 1)]
    else lfsr(i - 1)
  );
  lfsr(width - 1);
}