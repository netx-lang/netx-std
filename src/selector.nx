/**
  * NetX Standard Library - Selector and Logic Components
  * 
  * This library provides multiplexing, demultiplexing, encoding, and decoding components
  * for use in NetX designs.
  * 
  * @file selector.nx
  */
library selector;

/**
  * Multiplexer
  *
  * This component implements a 2^width-to-1 multiplexer that selects one of multiple
  * input signals based on the selector value.
  *
  * @attr width      Number of selector bits (supports 2^width inputs)
  *
  * @port selector   Selection control signal
  * @port input      Array of input signals to select from
  * @port output     Selected output signal
  */
component MUX(width) : [sel] :: [case[i] | i in [0..W]] -> [output] {
  let W = 2**width;
  wire sel  of bit(width);
  wire mask of bit(W);
  auto case[W], output;

  mask <> DECODER(width) <> sel;
  output <> OR(W) <> [
    AND <> [case[i], CAST <> mask[i]] | i in [0..W]
  ];
}

/**
  * Demultiplexer
  *
  * This component implements a 1-to-2^width demultiplexer that routes a single
  * input signal to one of multiple outputs based on the selector value.
  *
  * @attr width      Number of selector bits (supports 2^width outputs)
  *
  * @port selector   Selection control signal
  * @port input      Input signal to be routed
  * @port output     Array of output signals
  */
component DEMUX(width) : [sel, input] -> [output[i] | i in [0..W]] {
  let W = 2**width;
  wire sel  of bit(width);
  wire mask of bit(W);
  auto input, output[W];

  mask <> DECODER(width) <> sel;
  for (i in [0..W]) {
    output[i] <> AND <> [input, CAST <> mask[i]];
  }
}

/**
  * Binary Decoder
  *
  * This component implements a width-to-2^width binary decoder that converts
  * a binary input to a one-hot output representation.
  *
  * @attr width      Number of input bits (produces 2^width outputs)
  *
  * @port input      Binary input value
  * @port output     One-hot decoded output (2^width bits)
  */
component DECODER(width) : [input] -> [output] {
  let W = 2**width;
  wire input  of bit(width);
  wire output of bit(W);
  
  for (i in [0..W]) {
    output[i] <> AND(width) <> [port |
      j in [0..width],
      let port = if (i >> j) & 1 then TO else NOT
    ] <> [input[j] | j in [0..width]];
  }
}

/**
  * Binary Encoder
  *
  * This component implements a 2^width-to-width binary encoder that converts
  * a one-hot input representation to a binary output value.
  *
  * @attr width      Number of output bits (accepts 2^width inputs)
  *
  * @port input      One-hot input value (2^width bits)
  * @port output     Binary encoded output
  */
component ENCODER(width) : [input] -> [output] {
  let W = 2**width;
  wire input  of bit(W);
  wire output of bit(width);
  
  for (i in [0..width]) {
    output[i] <> OR(2**(width-1)) <> [
      input[j] | j in [0..W], when (j >> i) & 1
    ];
  }
}

/**
  * Priority Encoder
  *
  * This component implements a 2^width-to-width priority encoder that finds
  * the highest priority (highest index) active input and encodes its position.
  *
  * @attr width      Number of output bits (accepts 2^width inputs)
  *
  * @port input      Priority input signals (2^width bits)
  * @port output     Binary encoded position of highest priority active input
  */
component PRIORITY_ENCODER(width) : [input] -> [output] {
  let W = 2**width;
  wire input  of bit(W);
  wire output of bit(width);

  wire mask of bit(W);
  for (i in [0..W]) {
    if i == W - 1 then
      mask[i] <> input[i];
    else
      mask[i] <> AND(W - i) <> input[i] :: [NOT <> input[j] | j in [i + 1..W]];
  }
  output <> ENCODER(width) <> mask;
} 

/**
  * Arbiter
  *
  * This component implements a simple arbiter that grants access to one of multiple
  * requesters based on priority (lower index has higher priority).
  *
  * @attr width      Number of requesters
  *
  * @port request    Array of request signals
  * @port grant      Array of grant signals
  */
component ARBITER(width) : [request] -> [grant] {
  wire request of bit(width);
  wire grant   of bit(width);

  let pre_req(i) = 
    if i == 0 then request[0]
    else OR <> [request[i], pre_req(i - 1)];

  grant[0] <> request[0];
  for (i in [1..width]) {
      grant[i] <> AND <> [request[i], NOT <> pre_req(i - 1)];
  }
}