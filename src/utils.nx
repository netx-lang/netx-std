library utils;

import selector.MUX;

component REG(pos_edge, high_rst, rst_value) : [clk, rst, input] -> [output] {
  wire clk of clock();
  wire rst of bit(1);
  auto input, output;

  let casted = CAST <> rst_value;
  let reg = REGISTER(pos_edge) <> [TO, clk#];  
  output <> reg <> MUX(1) <> (
    if high_rst
    then [rst, input, casted]
    else [rst, casted, input]
  );
}

component HEX_TO_7SEG: [num] -> [code] {
  wire num  of bit(4);
  wire code of bit(7);
  code <> MUX(4) <> [
    num,
    7'b1000000, // 0
    7'b1111001, // 1
    7'b0100100, // 2
    7'b0110000, // 3
    7'b0011001, // 4
    7'b0010010, // 5
    7'b0000010, // 6
    7'b1111000, // 7
    7'b0000000, // 8
    7'b0010000, // 9
    7'b0001000, // A
    7'b0000011, // b
    7'b1000110, // C
    7'b0100001, // d
    7'b0000110, // E
    7'b0001110  // F
  ];
}
