library utils;

component REG(isPosEdge, isHighRst) : [clk, rst, rst_in, input] -> [output] {
  wire clk of clock();
  wire rst of bit(1);
  auto input, rst_in, output;
  
  let baseReg = REGISTER(isPosEdge) <> [TO, clk#];

  let neg_rst = NOT <> rst;
  let rstCond = CAST <> if isHighRst then rst else neg_rst;
  let inpCond = CAST <> if isHighRst then neg_rst else rst;

  output <> baseReg <> OR <> [
    AND <> [input, inpCond],
    AND <> [rst_in, rstCond]
  ];
}