/**
  * NetX Standard Library
  * 
  * This library provides utility components for use in NetX designs.
  * 
  * @file utils.nx
  */
library utils;

import selector.MUX;


/**
  * Register component
  *
  * This component implements a register with synchronous reset.
  *
  * @attr pos_edge   Triggers on rising edge of clock when true
  * @attr high_rst   Enables active-high reset when true
  * @attr rst_value  Value to load on reset
  *
  * @port clk        Clock signal
  * @port rst        Reset signal
  * @port input      Input data to be registered
  * @port output     Output data from the register
  */
component REG(pos_edge, high_rst, rst_value) : [clk, rst, input] -> [output] {
  wire clk of clock();
  wire rst of bit(1);
  auto input, output;

  let casted = CAST <> rst_value;
  let reg = REGISTER(pos_edge) <> [TO, clk#];  
  output <> reg <> MUX(1) <> (
    if high_rst
    then [rst, input, casted]
    else [rst, casted, input]
  );
}

/**
  * Hexadecimal to 7-segment display decoder
  *
  * This component converts a 4-bit hexadecimal number to a 7-segment display code.
  *
  * @port num        Input hexadecimal number (4 bits)
  * @port code       Output 7-segment display code (7 bits)
  */
component HEX_TO_7SEG: [num] -> [code] {
  wire num  of bit(4);
  wire code of bit(7);
  code <> MUX(4) <> [
    num,
    7'b1000000, // 0
    7'b1111001, // 1
    7'b0100100, // 2
    7'b0110000, // 3
    7'b0011001, // 4
    7'b0010010, // 5
    7'b0000010, // 6
    7'b1111000, // 7
    7'b0000000, // 8
    7'b0010000, // 9
    7'b0001000, // A
    7'b0000011, // b
    7'b1000110, // C
    7'b0100001, // d
    7'b0000110, // E
    7'b0001110  // F
  ];
}
