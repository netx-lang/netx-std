application selector_test;

import selector.*;

component mux_1_test : [cond, t, b] -> [out] {
  wire cond      of bit(1);
  wire t, b, out of bit(32);
  out <> MUX(1) <> [cond, b, t];
}

enum COLOR {
  RED, GREEN, YELLOW
}

component mux_enum_test : [cond] -> [out] {
  wire cond, out of COLOR;
  out <> MUX(2) <> {
    sel : cond,
    case[RED]    : GREEN,
    case[GREEN]  : YELLOW,
    case[YELLOW] : RED,
    $default     : 2'b11
  };
}

component mux_5_test : [cond] -> [out] {
  wire cond      of bit(5);
  wire out       of bit(32);
  out <> MUX(5) <> [cond] :: [ i | i in [0..32] ];
}

component demux_5_test : [cond, input] -> [out] {
  wire cond      of bit(5);
  wire input     of bit(32);
  wire out[32]   of bit(32);
  [out[i] | i in [0..32]] <> DEMUX(5) <> [cond, input];
}

component decoder_5_test : [input] -> [output] {
  wire input  of bit(5);
  wire output of bit(32);
  output <> DECODER(5) <> input;
}

component encoder_5_test : [input] -> [output] {
  wire input  of bit(32);
  wire output of bit(5);
  output <> ENCODER(5) <> input;
}

component priority_encoder_3_test : [input] -> [output] {
  wire input  of bit(8);
  wire output of bit(3);
  output <> PRIORITY_ENCODER(3) <> input;
}

component arbiter_4_test : [request] -> [grant] {
  wire request of bit(4);
  wire grant   of bit(4);
  grant <> ARBITER(4) <> request;
}