application memory_test;

import memory.*;

component reg_file_32 : [clk, rst, rd_addr_a, rd_addr_b, wr_en, wr_addr, din] -> [dout_a, dout_b] {
    wire clk of clock();
    wire rst, wr_en of bit(1);
    wire rd_addr_a, rd_addr_b, wr_addr of bit(5);
    wire din, dout_a, dout_b of bit(32);

    [dout_a, dout_b] <> RegFile(
        width=32, 
        capacity=5, 
        isPosEdge=true, 
        isHighRst=true
    ) <> [clk, rst, rd_addr_a, rd_addr_b, wr_en, wr_addr, din];
}

component sync_fifo_16: [clk, rst, wr_en, rd_en, din] -> [dout, empty, full] {
    wire clk of clock();
    wire din, dout of bit(32);
    wire rst, wr_en, rd_en, empty, full of bit(1);

    [dout, empty, full] <> SyncFIFO(
        width=32, 
        capacity=4, 
        isPosEdge=true, 
        isHighRst=true
    ) <> [clk, rst, wr_en, rd_en, din];
}