application memory_test;

import memory.*;

component shift_reg_32_test: [clk, rst, rst_value, din] -> [dout] {
    wire clk of clock();
    wire rst, din of bit(1);
    wire rst_value, dout of bit(32);

    dout <> SHIFT_REG (
        width=32, 
        pos_edge=true, 
        high_rst=true,
        rst_value=rst_value
    ) <> [clk, rst, din];
}

component reg_file_32_test: [clk, rst, rd_addr_a, rd_addr_b, wr_en, wr_addr, din] -> [dout_a, dout_b] {
    wire clk of clock();
    wire rst, wr_en of bit(1);
    wire rd_addr_a, rd_addr_b, wr_addr of bit(5);
    wire din, dout_a, dout_b of bit(32);

    [dout_a, dout_b] <> REG_FILE(
        width=32, 
        capacity=5, 
        pos_edge=true, 
        high_rst=true
    ) <> [clk, rst, rd_addr_a, rd_addr_b, wr_en, wr_addr, din];
}

component sync_fifo_16_test: [clk, rst, wr_en, rd_en, din] -> [dout, empty, full] {
    wire clk of clock();
    wire din, dout of bit(32);
    wire rst, wr_en, rd_en, empty, full of bit(1);

    [dout, empty, full] <> SYNC_FIFO(
        width=32, 
        capacity=4, 
        pos_edge=true, 
        high_rst=true
    ) <> [clk, rst, wr_en, rd_en, din];
}