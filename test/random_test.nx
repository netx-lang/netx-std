application random_test;

import random.*;

component fib_lfsr_16_test : [clk, rst] -> [output] {
  wire clk of clock();
  wire rst of bit(1);
  wire output of bit(16);
  output <> FIB_LFSR (
    width=16, 
    pos_edge=true, 
    high_rst=true, 
    seed=16'hFFFF, 
    taps=[16, 14, 13, 11]
  ) <> [clk, rst];
}

component galois_lfsr_16_test : [clk, rst] -> [output] {
  wire clk of clock();
  wire rst of bit(1);
  wire output of bit(16);
  output <> GALOIS_LFSR (
    width=16, 
    pos_edge=true, 
    high_rst=true, 
    seed=16'hA5A5, 
    taps=[2, 3, 5]
  ) <> [clk, rst];
}